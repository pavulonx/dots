#!/bin/sh

: "${AUR_HELPER:?AUR_HELPER must be set}"

if [ -f '/etc/os-release' ]; then
  os="$(grep '^ID=' /etc/os-release)"; os="${os#ID=}"
else
  os="$(uname -o)"
fi

_info() {
  printf "\33[1m%s\33[0m\n" "$1"
}

_arch() {
  if "$AUR_HELPER" --version >/dev/null 2>&1; then
    if [ "$AUR_HELPER" = "paru" ]; then
      _info "paru -Syu --upgrademenu"
      "$AUR_HELPER" -Syu --upgrademenu
    elif [ "$AUR_HELPER" = "yay" ]; then
      _info "yay -Syu"
      "$AUR_HELPER" -Syu
    else
      echo "Unsupported AUR helper: $AUR_HELPER" >&2
      return 1
    fi
  else
    echo "AUR helper not found: $AUR_HELPER" >&2
    echo "Falling back to pacman - AUR will not be updated" >&2
    pacman -Syu
  fi
}

_flatpak() {
  if command -V flatpak >/dev/null 2>&1; then
    _info "flatpak update"
    flatpak update
  fi
}

_updatestatus() {
  if command -V updatestatus >/dev/null 2>&1; then
    _info "Refreshing updatestatus"
    updatestatus -r
  fi
}

retval=0

case "$os" in
  arch|artix)
    _arch || retval=$((retval + $?))
    echo
    _flatpak || retval=$((retval + $?))
    echo
    _updatestatus
    ;;
  debian|ubuntu)
    _info "${SUDO:-sudo} apt-get update && ${SUDO:-sudo} apt-get upgrade"
    "${SUDO:-sudo}" apt-get update && "${SUDO:-sudo}" apt-get upgrade || retval=$((retval + $?))
    echo
    _flatpak || retval=$((retval + $?))
    echo
    _updatestatus
    ;;
  Android)
    pkg update && pkg upgrade ;;
  *)
    echo "Not implemented for os: $os"; exit 1;;
esac

[ "$1" = "-w" ] &&
  _info "> Press Return to exit <" &&
  read -r;

exit $retval

# vi: syntax=sh
